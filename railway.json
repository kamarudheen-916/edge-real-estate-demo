{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "bash build.sh"
    },
    "deploy": {
        "startCommand": "php artisan migrate --force && php-fpm -D && nginx -g 'daemon off;'",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
